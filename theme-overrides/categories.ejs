<h1 class="page-title-header"><%- getPageTitle(page) %></h1>
<div class="category-list-content">
  <% if (!site.categories.length) { %>
    <div class="taxonomy-empty" role="status">
      <p class="taxonomy-empty-title">暂无分类</p>
      <p class="taxonomy-empty-description">文章分类会显示在这里。</p>
    </div>
  <% } else { %>
    <% let categoryColorIndex = 0; %>
    <%- list_categories(site.categories, { class: 'all-category', depth: 5, style: 'list' })
      .replace(/<\/a><span class="all-category-list-count">(\d+)<\/span>/g,
        '<span class="all-category-list-count">$1</span></a>')
      .replace(/<li class="all-category-list-item">/g, () =>
        `<li class="all-category-list-item" style="--tag-hue: ${(345 + categoryColorIndex++ * 137.508) % 360}">`) %>
  <% } %>
</div>
<div class="category-comments">
  <% if (page.comment) { %><%- partial('components/comments/comment') %><% } %>
</div>
